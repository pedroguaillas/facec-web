    "fuzzysort": "^3.1.0",
    "get-tsconfig": "^4.14.0",
    "giget": "^3.3.0",
    "magic-string": "^0.30.21",
    "nypm": "^0.6.8",
    "ofetch": "^1.5.1",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "pathe": "^2.0.3",
    "postcss": "^8.5.19",
    "postcss-selector-parser": "^7.1.4",
    "prompts": "^2.4.2",
    "reka-ui": "^2.10.1",
